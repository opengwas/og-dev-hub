# Pixi-managed environments and cache: reproduced from pixi.toml + pixi.lock,
# never committed.
.pixi/
*.egg-info/
__pycache__/

# The site data (`pixi run site-data`, and the collection `pixi run site` reads).
docs/_data/

# setuptools' output when another environment installs this repository from a
# path (opengwasdb-stores' `dev` does, for its architecture checks).
build/

# The site (og-dev-hub#15): `pixi run site` writes it here, and clones into .work/
# on a machine without /data.
_site/
.work/
